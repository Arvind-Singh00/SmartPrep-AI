# Frontend environment example
# Copy this file to .env and replace placeholder values.
# Do not commit real secrets.

# Production default: real backend
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api

# Optional override for deployed backend origin
# Example: https://smartprep-backend.onrender.com
# VITE_API_ORIGIN=https://smartprep-backend.onrender.com
